# ==============================================================================
# Restaurant OS — Mẫu Biến Môi Trường Frontend Next.js 15 (.env.example)
# ==============================================================================
# HƯỚNG DẪN:
# - Tạo file cấu hình cục bộ: `cp .env.example .env.local`
# - LƯU Ý BẢO MẬT: Các biến có tiền tố `NEXT_PUBLIC_` sẽ được phơi bày trực tiếp
#   ra trình duyệt máy khách (Client-side). Tuyệt đối không đặt mật khẩu, API Secret
#   vào các biến có tiền tố này!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Kết Nối REST API Backend
# ------------------------------------------------------------------------------
# Base URL kết nối tới API Spring Boot Backend
# - Môi trường Local: http://localhost:8080/api/v1
# - Môi trường Production: https://api.yourdomain.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# ------------------------------------------------------------------------------
# 2. Kết Nối STOMP WebSocket Thời Gian Thực (<50ms)
# ------------------------------------------------------------------------------
# Endpoint SockJS / STOMP WebSocket để đồng bộ realtime KDS Bếp và Giỏ hàng bàn
# - Môi trường Local: http://localhost:8080/ws
# - Môi trường Production: https://api.yourdomain.com/ws
NEXT_PUBLIC_WS_URL=http://localhost:8080/ws

# ------------------------------------------------------------------------------
# 3. Kết Nối Microservice Xử Lý Giọng Nói AI (FastAPI Whisper)
# ------------------------------------------------------------------------------
# Base URL gọi tới dịch vụ phiên âm Voice-to-Order
# - Môi trường Local: http://localhost:8000/api/v1
# - Môi trường Production: https://ai.yourdomain.com/api/v1
NEXT_PUBLIC_AI_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# 4. Cấu Hình Cổng Chạy (Local Dev Server)
# ------------------------------------------------------------------------------
# Cổng chạy của máy chủ phát triển Next.js (mặc định: 3000)
PORT=3000
