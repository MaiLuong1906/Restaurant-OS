# ==============================================================================
# Restaurant OS — Mẫu Biến Môi Trường AI Voice Microservice (.env.example)
# ==============================================================================
# HƯỚNG DẪN:
# - Tạo file cấu hình cục bộ: `cp .env.example .env`
# - Quản lý cấu hình chạy FastAPI và Whisper model pipeline
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cấu Hình Máy Chủ FastAPI & Uvicorn
# ------------------------------------------------------------------------------
# Cổng chạy của AI Service (mặc định: 8000)
PORT=8000

# Địa chỉ lắng nghe: 0.0.0.0 (chấp nhận kết nối từ mọi giao diện mạng/Docker) hoặc 127.0.0.1
HOST=0.0.0.0

# Bật chế độ debug và tự động reload code khi chỉnh sửa (chỉ dùng cho development)
DEBUG=True

# ------------------------------------------------------------------------------
# 2. Cấu Hình Mô Hình Nhận Diện Giọng Nói Whisper
# ------------------------------------------------------------------------------
# Kích thước mô hình Whisper:
# - tiny: ~39MB, tốc độ siêu nhanh, độ chính xác cơ bản
# - base: ~74MB, cân bằng hoàn hảo cho máy tính dev (Khuyên dùng cho Local Dev)
# - small: ~244MB, độ chính xác cao cho tiếng Việt có tạp âm môi trường quán ăn
# - medium: ~769MB, chuyên dùng cho server có GPU
WHISPER_MODEL_SIZE=base

# Thiết bị tính toán:
# - cpu: Chạy bằng vi xử lý CPU thông thường
# - cuda: Chạy tăng tốc bằng card đồ họa rời NVIDIA (yêu cầu cài CUDA Toolkit)
DEVICE=cpu

# ------------------------------------------------------------------------------
# 3. Bảo Mật Truy Cập Nội Bộ
# ------------------------------------------------------------------------------
# API Key nội bộ dùng để xác thực các cuộc gọi giữa Spring Boot Backend và AI Service
INTERNAL_API_KEY=replace_this_with_an_internal_service_api_key_for_backend_communication
