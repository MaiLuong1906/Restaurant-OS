# ==============================================================================
# Restaurant OS Monorepo .gitignore
# ==============================================================================

# --- Bảo Mật & Biến Môi Trường (Zero-Leakage Secrets) ---
.env
.env.*
!.env.example
*.pem
*.key
application-secrets.yml

# --- File Tạm & File Khóa Của Microsoft Office ---
~$*
~$*.docx
~$*.doc
~$*.xlsx
# --- Thư Mục Tạm & Clone Tham Khảo ---
clone/
*.tmp

# --- Hệ Thống & IDE ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo

# --- Node.js & Frontend (pnpm, Next.js) ---
node_modules/
.pnpm-store/
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# --- Java & Backend (Spring Boot, Maven) ---
target/
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
hs_err_pid*

# --- Python & AI Microservice (FastAPI, Whisper) ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Logs & Báo Cáo Lỗi ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
