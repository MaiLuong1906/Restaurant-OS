# ==============================================================================
# Restaurant OS — Mẫu Biến Môi Trường Backend Spring Boot 3 (.env.example)
# ==============================================================================
# HƯỚNG DẪN:
# - Tạo file cấu hình cục bộ: `cp .env.example .env`
# - Khi chạy `./mvnw spring-boot:run` hoặc IDE, Spring Boot sẽ nạp các biến này
#   thông qua cấu hình trong `src/main/resources/application.yml`.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cấu Hình Cổng & Spring Profiles
# ------------------------------------------------------------------------------
# Cổng chạy của máy chủ nhúng Tomcat (mặc định: 8080)
PORT=8080

# Profile môi trường kích hoạt:
# - local: Kết nối DB cục bộ, bật log SQL format, hiển thị chi tiết lỗi
# - docker: Kết nối mạng nội bộ Docker container
# - prod: Tối ưu hiệu năng, ẩn thông tin nhạy cảm, kết nối Supabase SSL
SPRING_PROFILES_ACTIVE=local

# ------------------------------------------------------------------------------
# 2. Cấu Hình Kết Nối PostgreSQL (Quản lý qua Flyway)
# ------------------------------------------------------------------------------
# [Lựa chọn 1]: PostgreSQL Cục Bộ (Docker hoặc máy dev cài sẵn)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=restaurant_os
DB_USER=postgres
DB_PASSWORD=your_local_postgres_password_here

# [Lựa chọn 2]: Kết nối Supabase Cloud PostgreSQL (Production)
# Lưu ý: Cần kích hoạt SSL mode và dùng Session Pooler (port 6543)
# DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# DB_PORT=6543
# DB_NAME=postgres
# DB_USER=postgres.your_project_reference_id
# DB_PASSWORD=your_supabase_strong_password

# ------------------------------------------------------------------------------
# 3. Tích Hợp Microservice AI (FastAPI Whisper)
# ------------------------------------------------------------------------------
# Địa chỉ URL nội bộ của AI Service phục vụ bóc tách giọng nói gọi món
AI_SERVICE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 4. Bảo Mật Xác Thực JWT (JSON Web Token)
# ------------------------------------------------------------------------------
# Chuỗi khóa bí mật dùng để giải mã và kiểm tra tính toàn vẹn của Token (>= 256 bits)
JWT_SECRET_KEY=replace_this_with_your_super_secret_jwt_key_at_least_32_characters

# Thời gian hết hạn của Access Token (tính bằng mili-giây, ví dụ: 86400000 = 24 giờ)
JWT_EXPIRATION_MS=86400000
