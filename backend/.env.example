# ==============================================================================
# Restaurant OS — Mẫu Biến Môi Trường Backend Spring Boot 3 (.env.example)
# ==============================================================================
# HƯỚNG DẪN:
# - Copy file này thành `.env`: cp .env.example .env (hoặc sửa trực tiếp file .env)
# - Chọn Lựa chọn 1 (Docker Local) hoặc Lựa chọn 2 (Supabase Cloud) tùy nhu cầu.
# ==============================================================================

# 1. Cấu hình Cổng & Spring Profile
PORT=8080
SPRING_PROFILES_ACTIVE=local

# ------------------------------------------------------------------------------
# 2. Cấu hình Cơ sở dữ liệu PostgreSQL
# ------------------------------------------------------------------------------

# [LỰA CHỌN 1 — MẶC ĐỊNH]: Chạy Database PostgreSQL cục bộ qua DOCKER (Offline)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=restaurant_os
DB_USER=postgres
DB_PASSWORD=postgres

# [LỰA CHỌN 2]: Kết nối Database chung trên SUPABASE CLOUD (Khi cần test chung team)
# DB_HOST=db.dnkgjuyrygvvzrdgvcuu.supabase.co
# DB_PORT=5433
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=your_supabase_password_here

# 3. Tích hợp Microservice AI (FastAPI Whisper)
AI_SERVICE_URL=http://localhost:8000

# 4. Bảo mật Token JWT (>= 256 bits)
JWT_SECRET_KEY=replace_this_with_your_super_secret_jwt_key_at_least_32_characters
