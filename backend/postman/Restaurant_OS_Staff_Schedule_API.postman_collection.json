                  "",
                  "pm.test(\"Idempotency trả về đúng bản ghi cũ, không tạo mới\", function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.success).to.be.true;",
                  "    pm.expect(res.data.id).to.eql(pm.collectionVariables.get(\"registrationId\"));",
                  "    pm.expect(res.data.idempotencyKey).to.eql(pm.collectionVariables.get(\"currentIdempotencyKey\"));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
