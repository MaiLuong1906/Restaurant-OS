    {
      "name": "1. Danh Sách Ca Mở (Open Shifts)",
      "item": [
        {
          "name": "1.1. Lấy danh sách ca mở hợp lệ (Happy Path)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code là 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Phản hồi đúng chuẩn ApiResponse envelope\", function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.success).to.be.true;",
                  "    pm.expect(Array.isArray(res.data)).to.be.true;",
                  "});",
                  "",
                  "const res = pm.response.json();",
                  "if (res.data && res.data.length > 0) {",
                  "    const firstShift = res.data[0];",
                  "    pm.collectionVariables.set(\"openShiftId\", firstShift.id);",
                  "    console.log(\"Đã lưu openShiftId tự động:\", firstShift.id);",
                  "    ",
                  "    pm.test(\"Bản ghi ca mở có đầy đủ trường thông tin\", function () {",
                  "        pm.expect(firstShift).to.have.property(\"id\");",
                  "        pm.expect(firstShift).to.have.property(\"dateKey\");",
                  "        pm.expect(firstShift).to.have.property(\"startTime\");",
                  "        pm.expect(firstShift).to.have.property(\"endTime\");",
                  "        pm.expect(firstShift).to.have.property(\"role\");",
                  "        pm.expect(firstShift).to.have.property(\"slotsTotal\");",
                  "        pm.expect(firstShift).to.have.property(\"slotsTaken\");",
                  "    });",
                  "} else {",
                  "    console.warn(\"Chưa có ca mở nào trong ngày \" + pm.collectionVariables.get(\"testDate\") + \". Hãy chạy câu lệnh SQL Seed!\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/staff/schedule/open-shifts?dateKey={{testDate}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "staff",
                "schedule",
                "open-shifts"
              ],
              "query": [
                {
                  "key": "dateKey",
                  "value": "{{testDate}}",
                  "description": "Ngày cần lấy lịch ca (yyyy-MM-dd)"
                }
              ]
            }
          }
        },
        {
          "name": "1.2. Lấy danh sách ca mở khi thiếu tham số dateKey (Negative Test)",
