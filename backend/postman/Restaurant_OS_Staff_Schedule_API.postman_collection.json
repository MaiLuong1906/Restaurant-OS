    {
      "name": "2. Đăng Ký Ca Làm Việc (Shift Registration)",
      "item": [
        {
          "name": "2.1. Đăng ký ca làm việc thành công (Happy Path)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Tự động sinh Idempotency Key UUID v4 ngẫu nhiên",
                  "const uuid = pm.variables.replaceIn('{{$guid}}');",
                  "pm.collectionVariables.set('currentIdempotencyKey', uuid);",
                  "console.log('Khởi tạo idempotencyKey cho lượt đăng ký:', uuid);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code là 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Phản hồi đúng chuẩn ApiResponse và lưu registrationId\", function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.success).to.be.true;",
                  "    pm.expect(res.data).to.have.property(\"id\");",
                  "    pm.expect(res.data.status).to.eql(\"REGISTERED\");",
                  "    pm.expect(res.data.idempotencyKey).to.eql(pm.collectionVariables.get(\"currentIdempotencyKey\"));",
                  "    ",
                  "    pm.collectionVariables.set(\"registrationId\", res.data.id);",
                  "    console.log(\"Đã lưu registrationId:\", res.data.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"openShiftId\": \"{{openShiftId}}\",\n  \"staffId\": \"{{staffId}}\",\n  \"dateKey\": \"{{testDate}}\",\n  \"status\": \"REGISTERED\",\n  \"note\": \"Đăng ký ca phục vụ bàn sáng - Test Postman\",\n  \"idempotencyKey\": \"{{currentIdempotencyKey}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/staff/schedule/registrations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "staff",
                "schedule",
                "registrations"
              ]
            }
          }
        },
