            "body": {
              "mode": "raw",
              "raw": "{\n  \"openShiftId\": \"{{openShiftId}}\",\n  \"staffId\": \"{{staffId}}\",\n  \"dateKey\": \"{{testDate}}\",\n  \"status\": \"REGISTERED\",\n  \"note\": \"Gửi lặp lại cùng idempotencyKey\",\n  \"idempotencyKey\": \"{{currentIdempotencyKey}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/staff/schedule/registrations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "staff",
                "schedule",
                "registrations"
              ]
