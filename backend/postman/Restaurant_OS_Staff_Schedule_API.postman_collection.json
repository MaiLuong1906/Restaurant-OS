        {
          "name": "3.2. Kiểm tra slot ca mở sau khi hủy (Xác minh slot được hoàn lại)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code là 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const res = pm.response.json();",
                  "if (res.data && res.data.length > 0) {",
                  "    const targetShift = res.data.find(s => s.id === pm.collectionVariables.get(\"openShiftId\"));",
                  "    if (targetShift) {",
                  "        pm.test(\"Slot taken của ca không bị âm\", function () {",
                  "            pm.expect(targetShift.slotsTaken).to.be.at.least(0);",
                  "        });",
                  "        console.log(\"Số slot hiện tại của ca sau hủy:\", targetShift.slotsTaken, \"/\", targetShift.slotsTotal);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
