# ==============================================================================
# Restaurant OS Monorepo — Mẫu Cấu Hình Biến Môi Trường Gốc (.env.example)
# ==============================================================================
# HƯỚNG DẪN:
# 1. Sao chép file này thành .env trên máy của bạn: `cp .env.example .env`
# 2. Điền các giá trị thực tế tương ứng với môi trường làm việc của bạn.
# 3. TUYỆT ĐỐI KHÔNG commit file .env (chứa mật khẩu thật) lên kho Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Môi Trường Hoạt Động (Environment Mode)
# ------------------------------------------------------------------------------
# Giá trị hợp lệ: development | test | production
NODE_ENV=development

# Profile môi trường kích hoạt cho Spring Boot: local | docker | prod
ENVIRONMENT=local

# ------------------------------------------------------------------------------
# 2. Cơ Sở Dữ Liệu PostgreSQL (Database Connection)
# ------------------------------------------------------------------------------
# [Lựa chọn A]: Khi chạy cục bộ bằng Docker Compose
# - Tên Database quản lý nhà hàng:
DB_NAME=restaurant_os
# - Tên tài khoản quản trị PostgreSQL:
DB_USER=postgres
# - Mật khẩu đăng nhập (Thay đổi thành mật khẩu an toàn của bạn):
DB_PASSWORD=your_secure_postgres_password_here
# - Địa chỉ Host của Database (localhost khi chạy standalone, postgres khi chạy trong Docker):
DB_HOST=localhost
# - Cổng kết nối PostgreSQL (mặc định: 5432):
DB_PORT=5432

# [Lựa chọn B]: Khi kết nối tới Supabase Cloud Production
# DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# DB_PORT=6543
# DB_NAME=postgres
# DB_USER=postgres.your_supabase_project_ref
# DB_PASSWORD=your_supabase_database_password

# ------------------------------------------------------------------------------
# 3. Cổng Dịch Vụ Các Sub-projects (Port Allocation)
# ------------------------------------------------------------------------------
# Cổng phục vụ ứng dụng Frontend Web (Next.js 15):
FRONTEND_PORT=3000

# Cổng phục vụ Backend Lõi (Spring Boot 3 + Java 21):
BACKEND_PORT=8080

# Cổng phục vụ Microservice Trợ Lý Giọng Nói AI (FastAPI Python):
AI_PORT=8000

# ------------------------------------------------------------------------------
# 4. Bảo Mật & Khóa Bí Mật (Security Secrets)
# ------------------------------------------------------------------------------
# Khóa bí mật dùng để ký và xác thực JWT Token (HMAC-SHA256, tối thiểu 256 bits).
# MẸO: Bạn có thể sinh chuỗi ngẫu nhiên bằng lệnh: `openssl rand -base64 32`
JWT_SECRET=replace_this_with_a_secure_random_256_bit_secret_key_minimum_32_chars
